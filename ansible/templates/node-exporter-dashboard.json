{
  "title": "Web Server Metrics",
  "uid": "web-server-metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{job=\"node_exporter_web_server\",mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU Usage {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory Usage (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"node_exporter_web_server\"} / node_memory_MemTotal_bytes{job=\"node_exporter_web_server\"}))",
          "legendFormat": "Memory Usage {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Disk Usage (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{job=\"node_exporter_web_server\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node_exporter_web_server\",mountpoint=\"/\"}) * 100)",
          "legendFormat": "Disk Usage {{instance}}",
          "refId": "A"
        }
      ]
    }
  ]
}
