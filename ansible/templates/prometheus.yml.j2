global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'node_exporter_web_server'
    static_configs:
      - targets: ['10.0.0.5:9100']
        labels:
          instance: 'web-server'

  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
